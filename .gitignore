# Python / tooling
__pycache__/
*.py[oc]
.venv/
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info

# Secrets — never commit; see .env.example
.env

# Raw HTML is ~250 KB per page (mostly site chrome). We commit the manifest and the cleaned
# text snapshot (data/docs.jsonl) instead; `uv run python -m rag.ingest` re-creates raw/.
data/raw/*.html

# Runtime query logs
logs/
